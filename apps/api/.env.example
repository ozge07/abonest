# Bu dosya depoda; gerçek değerler .env içinde ve .gitignore'da.
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://KULLANICI@localhost:5432/abonelik_takip?schema=public"

# En az 32 karakter. Üretmek için: openssl rand -base64 32
SESSION_SECRET="degistir-en-az-32-karakter-olmali-1234"
CRON_SECRET="degistir-en-az-32-karakter-olmali-5678"

WEB_ORIGIN="http://localhost:5173"
LOG_LEVEL=info

# Uygulamanın önündeki güvenilir vekil sayısı. Varsayılan kapalı (`false`).
# Açık olduğunda istemci `X-Forwarded-For` ile kendi IP'sini uydurabiliyor ve
# IP tabanlı hız sınırı işlevsiz kalıyor — ölçüldü, bkz. docs/security.md.
# Yayında uygulamanın önünde gerçekten vekil varsa sayısını yaz (çoğu
# platformda 1).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# E-posta gönderimi
#
# SMTP_HOST boşsa e-posta GÖNDERİLMEZ, sunucu günlüğüne yazılır. Geliştirmede
# istenen davranış bu. Yayında boş bırakılırsa uygulama açılmayı reddediyor:
# kullanıcılar hesaplarını doğrulayamazdı.
#
# Sağlayıcıya bağlı değiliz; SMTP konuşan her yer çalışır.
#   Gmail   : smtp.gmail.com   / 587 / uygulama şifresi (normal şifre değil)
#   Outlook : smtp-mail.outlook.com / 587
#   Brevo   : smtp-relay.brevo.com  / 587
# ---------------------------------------------------------------------------
# Yayında e-posta HTTP üzerinden gidiyor: barındırma platformlarının çoğu
# giden SMTP portlarını kapatıyor (ETIMEDOUT, command: CONN). Bu anahtar
# doluyken aşağıdaki SMTP ayarları kullanılmıyor.
BREVO_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gönderen adresi sağlayıcıda **doğrulanmış** olmalı; değilse gönderim
# sessizce düşüyor (SMTP "250 queued" diyor ama posta ulaşmıyor).
#
# Adresi nötr seç: sağlayıcılar doğrulanmamış alan adından gönderirken
# adresi kendi alt alan adına yeniden yazıyor ama **kullanıcı adı kısmını
# koruyor**. Kişisel bir adres kullanırsan adın alıcıya görünür.
MAIL_FROM="Abonest <abonest@ornek.com>"

# Yanıt adresi. Verilmezse yanıtlar gönderen adrese gidiyor.
MAIL_REPLY_TO=
